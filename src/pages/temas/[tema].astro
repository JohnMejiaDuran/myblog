---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';

export async function getStaticPaths() {
const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true }));

const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter.temas).flat())];

  return uniqueTags.map((tema) => {
    const filteredPosts = allPosts.filter((post: any) => post.frontmatter.temas.includes(tema));
    return {
      params: { tema },
      props: { posts: filteredPosts },
    };
});
}
const { tema } = Astro.params;
const { posts } = Astro.props;

---

<BaseLayout pageTitle={tema}>
  <p>temas de  {tema}</p>
  <ul>
    {posts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title}/>)}
  </ul>
</BaseLayout>