---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';
const pageTitle = "Home Page";
---
<BaseLayout pageTitle={pageTitle}>
	<p>Welcome to my Astro site! This is the home page.</p>
	<p>Here, I will share my journey of learning Astro and building this website.</p>
	<p>Stay tuned for more updates and blog posts!</p>
  <h2>My awesome blog subtitle</h2>
  <Greeting client:load messages={["Hej", "Hallo", "Hola", "Habari", "Hi", "Hello", "Howdy", "Hey there"]} />
</BaseLayout>